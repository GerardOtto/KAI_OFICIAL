# Plantilla de variables. Cópiala como `.env` junto a docker-composer.yml para
# Docker, o como `backend/.env` para correr el backend en local. Ningún `.env`
# se versiona.

# Con Docker, el host es `db`; en local, `localhost`.
DATABASE_URL=postgresql://postgres:365153gg@db:5432/KAI-PROJECT

# Obligatoria. Genérala con:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=

# Opcionales: sin ellas, el motor del asistente o el acceso con Google
# correspondiente se muestra deshabilitado.
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
GOOGLE_CLIENT_ID=
