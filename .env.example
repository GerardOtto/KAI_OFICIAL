# Plantilla de variables. Cópiala como `.env` junto a docker-compose.yml para
# Docker, o como `backend/.env` para correr el backend en local. Ningún `.env`
# se versiona. En Railway las variables van en la pestaña Variables de cada
# servicio; la tabla completa está en backend/migraciones/README.md
# («Variables de entorno del backend en Railway»).

# --- Base de datos -------------------------------------------------------------

# Contraseña de PostgreSQL. Obligatoria con Docker, que crea la base con ella.
# Usa solo letras y números: también va dentro de DATABASE_URL.
POSTGRES_PASSWORD=

# Para correr el backend en local (`backend/.env`), con el host `localhost`.
# Con Docker no hace falta: el contenedor la arma con POSTGRES_PASSWORD.
DATABASE_URL=postgresql://postgres:TU_CLAVE@localhost:5432/KAI-PROJECT

# Muy recomendada en producción: conexión con un usuario de base que solo es el
# rol `kai_asistente` (migración 019), para la consulta SQL libre del asistente.
DATABASE_URL_ASISTENTE=

# --- Sesiones -----------------------------------------------------------------

# Obligatoria, de al menos 32 bytes. Genérala con:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
# Horas de validez de una sesión (por defecto 12).
JWT_HORAS_VALIDEZ=

# Opcional: sin ella, el acceso con Google no se ofrece.
GOOGLE_CLIENT_ID=

# --- Asistente ----------------------------------------------------------------

# Opcionales: sin ellas, el motor correspondiente se muestra deshabilitado.
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
# Dominios de correo con acceso al asistente (por defecto pucv.cl,mail.pucv.cl).
KAI_DOMINIOS_ASISTENTE=

# --- Formulario de contacto («Contratar ahora») -------------------------------

CONTACTO_DESTINO=
SMTP_USUARIO=
SMTP_CLAVE=

# --- Despliegue ---------------------------------------------------------------

# `produccion` fuera de Railway (en Railway se detecta solo): cierra /docs, quita
# el acceso CORS desde localhost y agrega HSTS.
KAI_ENTORNO=
# Orígenes del frontend adicionales para CORS, separados por comas.
KAI_ORIGENES=
# Proxies delante del backend (1 en Railway): de esto depende la IP de los topes.
KAI_PROXIES_CONFIABLES=
