       return\n","\n","    # Datos para comparación\n","    promedio_top10 = df_top10[metricas_numericas].mean()\n","    data_inst = df_ranking.loc[mask_inst].iloc[0]\n","    nombre_inst = data_inst[\"Institucion\"]\n","\n","    # Crear DataFrame comparativo\n","    comparacion = pd.DataFrame({\n","        \"Métrica\": metricas_numericas,\n","        nombre_inst: [data_inst.get(c, 0) for c in metricas_numericas],\n","        \"Promedio Top 10\": [promedio_top10.get(c, 0) for c in metricas_numericas]\n","    })\n","\n","    comparacion[\"Diferencia\"] = comparacion[nombre_inst] - comparacion[\"Promedio Top 10\"]\n","    comparacion[\"Diferencia (%)\"] = (comparacion[\"Diferencia\"] / comparacion[\"Promedio Top 10\"].replace(0, np.nan) * 100).round(2)\n","    comparacion[\"Métrica\"] = comparacion[\"Métrica\"].replace(RENOMBRAMIENTO_METRICAS)\n","\n","    # Ordenar métricas\n","    score_display = RENOMBRAMIENTO_METRICAS.get(\"impacto_score\", \"impacto_score\")\n","    fila_score = comparacion[comparacion[\"Métrica\"] == score_display]\n","\n","    # Orden fijo basado en PESOS\n","    orden_fijo = [RENOMBRAMIENTO_METRICAS.get(key, key) for key in PESOS.keys() if key != 'impacto_score']\n","    mapping = {name: i for i, name in enumerate(orden_fijo)}\n","    comparacion_metricas = comparacion[comparacion[\"Métrica\"] != score_display].copy()\n","    comparacion_metricas = comparacion_metricas[comparacion_metricas[nombre_inst] + comparacion_metricas[\"Promedio Top 10\"] != 0]\n","    comparacion_metricas['Orden'] = comparacion_metricas['Métrica'].map(mapping)\n","    comparacion_metricas = comparacion_metricas.sort_values('Orden').drop(columns=['Orden'])\n","\n","    comparacion_final = pd.concat([fila_score, comparacion_metricas], ignore_index=True)\n","\n","    # Visualización\n","    print(f\"\\n📊 {nombre_inst} vs PROMEDIO TOP 10 ({YEARS_OBJETIVO})\")\n","    print(\"=\" * 70)\n","\n","    # Encabezados\n","    print(f\"{'MÉTRICA':<35} | {'INST':>10} | {'TOP10':>10}