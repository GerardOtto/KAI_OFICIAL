ol] = 0\n","\n","df[\"impacto_score\"] = sum(df[col] * peso for col, peso in PESOS.items())\n","df[\"RankingKAI\"] = df[\"impacto_score\"].rank(ascending=False, method=\"min\").astype(int)\n","\n","# Resultados\n","df_ranking = df[[\"RankingKAI\"] + [c for c in df.columns if c != \"RankingKAI\"]].sort_values(\"RankingKAI\")\n","\n","pd.set_option(\"display.max_columns\", None)\n","pd.set_option(\"display.width\", None)\n","print(f\"--- Ranking completo (years = {YEARS_OBJETIVO}) ---\")\n","display(df_ranking)\n","\n","# Función de simulación\n","def simular_cambio_con_ranking(universidad, atributo, nuevo_valor):\n","    df_sim = df.copy()\n","    mask = df_sim[\"Institucion\"].str.contains(universidad, case=False, na=False)\n","\n","    if not mask.any():\n","        print(f\"❌ No se encontró '{universidad}'\")\n","        return\n","    if atributo not in df_sim.columns:\n","        print(f\"❌ Atributo inválido: '{atributo}'\")\n","        return\n","\n","    df_sim.loc[mask, atributo] = float(str(nuevo_valor).replace(\",\", \".\"))\n","    df_sim[\"Altmetrics\"] = 0.7 * df_sim[\"plumx\"] + 0.3 * df_sim[\"mendeley\"]\n","    df_sim[\"impacto_score\"] = sum(df_sim[col] * peso for col, peso in PESOS.items())\n","    df_sim[\"RankingKAI\"] = df_sim[\"impacto_score\"].rank(ascending=False, method=\"min\").astype(int)\n","\n","    resultado = df_sim[[\"RankingKAI\"] + [c for c in df_sim.columns if c != \"RankingKAI\"]].sort_values(\"RankingKAI\")\n","    print(f\"🔄 Simulación: {atributo} → {nuevo_valor} para '{universidad}'\")\n","    display(resultado)\n","\n","simular_cambio_con_ranking(\"Universidad Andres Bello, Chile\", \"output\", 6400)\n"]},{"cell_type":"markdown","metadata":{"id":"gyffTflwReIB"},"source":["#❌ Comparar universidades"]},{"cell_type":"code","execution_count":null,"metadata":{"colab":{"base_uri":"https://localhost:8080/","height":913},"executionInfo":{"elapsed":56,"status":"ok","timestamp":1762902584470,"user":{"displayName":"Fernando Arellano","use