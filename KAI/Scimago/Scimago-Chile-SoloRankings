2,\n","    \"colab\": 0.02, \"open_access\": 0.02, \"stp\": 0.02, \"ik\": 0.10, \"patents\": 0.10,\n","    \"tech_impact\": 0.10, \"AM\": 0.03, \"web_size\": 0.03, \"sdg\": 0.05,\n","    \"female_stp\": 0.03, \"overton\": 0.03\n","}\n","\n","df"]},{"cell_type":"markdown","metadata":{"id":"G8d2pPty3g63"},"source":["# Simulación + Ranking"]},{"cell_type":"code","execution_count":12,"metadata":{"executionInfo":{"elapsed":43,"status":"ok","timestamp":1763508034618,"user":{"displayName":"GERARD MAURICIO OTTO SAGREDO","userId":"18329832569786394568"},"user_tz":180},"id":"PMmk1FbSgIo1"},"outputs":[],"source":["import pandas as pd\n","\n","def simular_cambio_con_ranking(universidad, atributo, nuevo_valor):\n","    df_sim = df.copy()\n","\n","    # Filtrar institución\n","    mask = df_sim[\"Institucion\"].str.contains(universidad, case=False, na=False)\n","    if not mask.any():\n","        print(f\"❌ No se encontró '{universidad}'\")\n","        return None\n","\n","    # Puntaje y ranking original\n","    puntaje_original = df_sim.loc[mask, \"PuntajeOriginalNormalizado\"].mean()\n","    ranking_original = df_sim.groupby(\"Institucion\")[\"PuntajeOriginalNormalizado\"].mean().sort_values(ascending=False)\n","    pos_original = ranking_original.index.get_loc(ranking_original.index[mask.any()]) + 1\n","\n","    # Simulación\n","    df_modificado = df_sim.copy()\n","    df_modificado.loc[mask, atributo] = nuevo_valor\n","\n","    # Recalcular con normalización\n","    for col in PESOS:\n","        if col in df_modificado.columns:\n","            min_val, max_val = df_modificado[col].min(), df_modificado[col].max()\n","            if max_val > min_val:\n","                df_modificado[col] = (df_modificado[col] - min_val) / (max_val - min_val) * 100\n","            else:\n","                df_modificado[col] = 0\n","\n","    df_modificado[\"PuntosFinal\"] = sum(df_modificado[col] * w for col, w in PESOS.items() if col in df_modificado.columns)\n","\n","    # Normalizar puntuación final\n","    min_pt, max_pt = df[\"PuntajeOriginalNormalizado\"].min(), df[\"PuntajeOriginalNormalizado\"].max()\n","    min_st, max_st = df_modificado[\"PuntosFinal\"].min(), df_modificado[\"PuntosFinal\"].max()\n","\n","    if max_st > min_st:\n","        df_modificado[\"PuntosFinal_normalizado\"] = ((df_modificado[\"PuntosFinal\"] - min_st) / (max_st - min_st)) * (max_pt - min_pt) + min_pt\n","    else:\n","        df_modificado[\"PuntosFinal_normalizado\"] = min_pt\n","\n","    puntaje_modificado = df_modificado.loc[mask, \"PuntosFinal_normalizado\"].mean()\n","\n","    # Ranking nuevo\n","    ranking_modificado = df_modificado.groupby(\"Institucion\")[\"PuntosFinal_normalizado\"].mean().sort_values(ascending=False)\n","    pos_modificada = ranking_modificado.index.get_loc(ranking_modificado.index[mask.any()]) + 1\n","\n","    # Resultados\n","    print(f\"🏫 Universidad: {universidad}\")\n","    print(f\"📊 Atributo modificado: {atributo}\")\n","    print(f\"🔄 Valor nuevo: {nuevo_valor}\")\n","    print(f\"📈 Puntaje original: {puntaje_original:.2f} (Posición #{pos_original})\")\n","    print(f\"📈 Puntaje con cambio: {puntaje_modificado:.2f} (Posición #{pos_modificada})\")\n","    print(f\"📊 Diferencia en score: {puntaje_modificado - puntaje_original:+.2f}\")\n","    print(f\"🏆 Diferencia en ranking: {pos_original - pos_modificada:+d} lugares\")\n","\n","    return df_modificado.sort_values(by=\"PuntosFinal_normalizado\", ascending=False)"]},{"cell_type":"markdown","metadata":{"id":"XvZ0qrEUx5F-"},"source":["# Ranking innovación"]},{"cell_type":"code","execution_count":6,"metadata":{"colab":{"base_uri":"https://localhost:8080/","height":1000},"executionInfo":{"elapsed":75,"status":"ok","timestamp":1763507813069,"user":{"displayName":"GERARD MAURICIO OTTO SAGREDO","userId":"18329832569786394568"},"user_tz":180},"id":"efSvKTElx4p2","outputId":"a99a9de2-6bc4-42ad-b776-dd4c5ef07ba1"},"outputs":[{"output_type":"stream","name":"stdout","text":["--- Ranking de Ins