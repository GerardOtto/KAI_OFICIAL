arcía,%20José/2014/?stype=single_year\",\n","    \"https://topscinet.com/scientist_profile/Campo,%20Antonio/1973/?stype=single_year\",\n","    \"https://topscinet.com/scientist_profile/Rincón,%20Angel/2015/?stype=single_year\",\n","    \"https://topscinet.com/scientist_profile/Lizana,%20Pablo%20A./2008/?stype=single_year\",\n","]\n","\n","\n","headers = {\n","    \"User-Agent\": \"Mozilla/5.0 (compatible; AcademicScraper/1.0)\"\n","}\n","\n","output_csv = \"resultados_scraping_por_anio.csv\"\n","\n","# ===============================\n","# FUNCIONES AUXILIARES\n","# ===============================\n","\n","def extract_scientist_name(url):\n","    try:\n","        raw_name = url.split(\"/scientist_profile/\")[1].split(\"/\")[0]\n","        return unquote(raw_name)\n","    except Exception:\n","        return None\n","\n","def extract_year_from_header(text):\n","    \"\"\"\n","    Extrae el año desde:\n","    'Data For The Year: 2020'\n","    \"\"\"\n","    match = re.search(r\"(\\d{4})\", text)\n","    return int(match.group(1)) if match else None\n","\n","# ===============================\n","# FUNCIÓN DE SCRAPING\n","# ===============================\n","\n","def scrape_scientist(url):\n","    response = requests.get(url, headers=headers, timeout=20)\n","    response.raise_for_status()\n","\n","    soup = BeautifulSoup(response.text, \"lxml\")\n","\n","    scientist_name = extract_scientist_name(url)\n","    rows = []\n","\n","    # Cada bloque anual\n","    sections = soup.find_all(\"div\", class_=\"row data-section\")\n","\n","    for section in sections:\n","        header = section.find(\"h5\")\n","        if not header:\n","            continue\n","\n","        year = extract_year_from_header(header.get_text(strip=True))\n","        if not year:\n","            continue\n","\n","        tbody = section.find(\"tbody\")\n","        if not tbody:\n","            continue\n","\n","        data = {\n","            \"url\": url,\n","            \"scientist_name\": scientist_name,\n","            \"year\": year\n","        }\n","\n","        for row in tbody.find_all(\"tr\"):\n","            cells = row.find_all(\"td\")\n","\n","            if len(cells) == 3:\n","                label = cells[0].get_text(strip=True)\n","                value_excl = cells[1].get_text(strip=True)\n","                value_all = cells[2].get_text(strip=True)\n","\n","                data[f\"{label} (Self-Citations Excluded)\"] = value_excl\n","                data[f\"{label} (All)\"] = value_all\n","\n","            elif len(cells) == 2:\n","                label = cells[0].get_text(strip=True)\n","\n","                progress = cells[1].find(\"span\")\n","                if progress:\n","                    value = progress.get_text(strip=True).replace(\"%\", \"\")\n","                    data[label] = value\n","                else:\n","                    data[label] = cells[1].get_text(strip=True)\n","\n","        rows.append(data)\n","\n","    return rows\n","\n","# ===============================\n","# EJECUCIÓN DEL SCRAPING\n","# ===============================\n","\n","all_rows = []\n","\n","for url in urls:\n","    try:\n","        print(f\"Scrapeando: {url}\")\n","        rows = scrape_scientist(url)\n","        all_rows.extend(rows)\n","        time.sleep(1)\n","    except Exception as e:\n","        print(f\"Error en {url}: {e}\")\n","\n","# ===============================\n","# EXPORTAR A CSV\n","# ===============================\n","\n","df = pd.DataFrame(all_rows)\n","df.sort_values(by=[\"scientist_name\", \"year\"], inplace=True)\n","\n","df.to_csv(output_csv, index=False, encoding=\"utf-8\")\n","\n","print(f\"\\nArchivo CSV generado: {output_csv}\")\n","df.head()\n"],"metadata":{"colab":{"base_uri":"https://localhost:8080/","height":742},"id":"op0hpq3LEl6h","executionInfo":{"status":"ok","timestamp":1767297787768,"user_tz":180,"elapsed":25041,"user":{"displayName":"GERARD MAURICIO OTTO SAGREDO","userId":"18329832569786394568"}},