dad Austral de Chile',\n","    'Catholic University of the North': 'Universidad Catolica del Norte',\n","    'Universidad Católica de la Santísima Concepción': 'Universidad Catolica de la Santisima Concepcion',\n","    'Temuco Catholic University': 'Universidad Catolica de Temuco',\n","    'Catholic University of Maule': 'Universidad Catolica del Maule',\n","    'Adolfo Ibáñez University': 'Universidad Adolfo Ibanez',\n","    'University Diego Portales': 'Universidad Diego Portales',\n","    'Diego Portales University': 'Universidad Diego Portales',\n","    'Universidad Andrés Bello (UNAB)': 'Universidad Andres Bello',\n","    'University of the Andes, Chile': 'Universidad de los Andes',\n","    'University of the Americas': 'Universidad de Las Americas',\n","    'Major University': 'Universidad Mayor',\n","    'San Sebastián University': 'Universidad San Sebastian',\n","    'Universidad Autónoma de Chile': 'Universidad Autonoma de Chile',\n","    'Central University of Chile': 'Universidad Central de Chile',\n","    'University of Development': 'Universidad del Desarrollo',\n","    'Finis Terrae University': 'Universidad Finis Terrae',\n","    'Alberto Hurtado University': 'Universidad Alberto Hurtado',\n","    'Bernardo O’Higgins University': 'Universidad Bernardo O\\'Higgins',\n","    'Gabriela Mistral University': 'Universidad Gabriela Mistral',\n","    'Pacific University': 'Universidad del Pacifico',\n","    'University of Vina del Mar': 'Universidad de Vina del Mar',\n","    'Adventist University of Chile': 'Universidad Adventista de Chile',\n","    'Academy of Christian Humanism University': 'Universidad Academia de Humanismo Cristiano',\n","    'Universidad Santo Tomás': 'Universidad Santo Tomas'\n","}\n","\n","# --- PROCESAMIENTO ---\n","\n","# A. Normalización y traducción\n","df_datos['nombre_normalizado'] = df_datos['Name'].str.strip().map(mapeo_ingles_espanol).fillna(df_datos['Name'].str.strip())\n","\n","# B. Cruce con el maestro para obtener IDs oficiales\n","df_final = pd.merge(\n","    df_datos,\n","    df_maestro[['id_universidad', 'nombre_universidad']],\n","    left_on='nombre_normalizado',\n","    right_on='nombre_universidad',\n","    how='left'\n",")\n","\n","# C. Respaldo para asegurar que no queden IDs vacíos en registros en español\n","if df_final['id_universidad'].isnull().any():\n","    mapeo_respaldo = dict(zip(df_maestro.nombre_universidad, df_maestro.id_universidad))\n","    df_final['id_universidad_y'] = df_final['id_universidad'].fillna(df_final['nombre_normalizado'].map(mapeo_respaldo))\n","else:\n","    df_final['id_universidad_y'] = df_final['id_universidad']\n","\n","# D. REEMPLAZO Y RENOMBRE:\n","# Eliminamos la antigua columna 'Field' y usamos el ID con el nombre 'id_universidad'\n","df_final['id_universidad'] = df_final['id_universidad_y'].astype('Int64')\n","\n","# E. Eliminación de todas las columnas solicitadas\n","# Eliminamos 'Field' original, 'Score', 'Country/Region', e 'Institution'\n","columnas_a_borrar = [\n","#  'rank_prefix',\n","    'Overall',\n","    'Rank',\n","    'year',\n","#    'nombre_normalizado',\n","#    'nombre_universidad',\n","#    'id_universidad_y'\n","]\n","df_final = df_final.drop(columns=columnas_a_borrar)\n","\n","# 4. Exportar a CSV\n","df_final.to_csv('documento_universidades_mapeadas.csv', index=False)\n","\n","print(\"¡Proceso completado! Columna 'Field' y 'Score' eliminadas. Se añadió 'id_universidad'.\")"],"metadata":{"colab":{"base_uri":"https://localhost:8080/"},"id":"80OqSFub0zB5","executionInfo":{"status":"ok","timestamp":1775885471995,"user_tz":240,"elapsed":23,"user":{"displayName":"GERARD MAURICIO OTTO SAGREDO","userId":"18329832569786394568"}},"outputId":"cfcc6390-4f62-4680-9fef-4e279e8ead62"},"execution_count":73,"outputs":[{"output_type":"stream","name":"stdout","text":["¡Proceso completado! Columna 'Field' y 'Score' eliminadas. Se añadió 'id_universidad'.\n"]}]},{"cell_type":"markdown","source":["# **Formateo ancho a largo**"],"metadata":{"id":"LuRlaLKpBGvX"}},{"cell_type":"code","source":["import pandas as pd\n","\n","# 1. Cargar el CSV generado en el paso anterior\n","df = pd.read_csv('documento_universidades_mapeadas.csv')\n","\n","# 2. Identificar las métricas que queremos transformar\n","metricas = ['Teaching', 'Research Environment', 'Research Quality', 'Industry', 'International Outlook']\n","# 3. Transformar el DataFrame de formato \"ancho\" a \"largo\"\n","# id_vars son las columnas que se quedan fijas (id_universidad)\n","# value_vars son las que se van a convertir en filas\n","df_long = df.melt(\n","    id_vars=['id_universidad'],#, 'Subject'],\n","    value_vars=metricas,\n","    var_name='metrica_base',\n","    value_name='valor_metrica'\n",")\n","\n","# 4. Crear la columna \"nombre_metrica\" combinando el nombre con el Subject entre paréntesis\n","df_long['nombre_metrica'] = df_long['metrica_base'] #+ \" (\" + df_long['Subject'] + \")\"\n","\n","# 5. Seleccionar solo las columnas finales y ordenar\n","# Ordenamos por id_universidad para que queden agrupadas como pediste\n","df_resultado = df_long[['id_universidad', 'nombre_metrica', 'valor_metrica']]\n","df_resultado = df_resultado.sort_values(by=['id_universidad', 'nombre_metrica'])\n","\n","# 6. Guardar el resultado final\n","df_resultado.to_csv('documento_vertical_estructurado.csv', index=False)\n","\n","print(\"Estructura transformada con éxito.\")\n","print(df_resultado.head(4))"],"metadata":{"colab":{"base_uri":"https://localhost:8080/"},"id":"1gqNlZp8BGkx","executionInfo":{"status":"ok","timestamp":1775885474431,"user_tz":240,"elapsed":41,"user":{"displayName":"GERARD MAURICIO OTTO SAGREDO","userId":"18329832569786394568"}},"outputId":"35710ffb-e330-4a23-f647-7cca5bb394f1"},"execution_count":74,"outputs":[{"output_type":"stream","name":"stdout","text":["Estructura transformada con éxito.\n","    id_universidad         nombre_metrica  valor_metrica\n","33               1               Industry           38.3\n","44               