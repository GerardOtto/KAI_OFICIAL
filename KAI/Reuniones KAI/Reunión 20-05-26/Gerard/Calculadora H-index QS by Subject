ll_type":"code","execution_count":2,"metadata":{"colab":{"base_uri":"https://localhost:8080/","height":640,"referenced_widgets":["d9a2ccdcda7942abad4e377da27dc07a","cf4ddcfe724940f0b011e62b725d10fb","d9608f3aa10148f0bd560ba847a9e02f","0b55dbbd2daa408a9564a5481c73f720","c84459d1b5674d9dba23005b965802d9","abc8071af2524a32a9d195c5a7a3cd35","91d5da69f878449c931ddd245790a1bd","635e16676164401db90f558c07626d7b","ef73acbba4f644b78dbada66c8e48f39","00d0342940d84ccab60c7f3ec5039784","e4ddcb2cf833481284a497f74cdbb2f9","6a11744fc93d42f29b5edb1aecc1e49b","177e7e75b43040db929c516403c93736"]},"id":"467QTDSxOJzP","executionInfo":{"status":"ok","timestamp":1779293994045,"user_tz":240,"elapsed":96,"user":{"displayName":"GERARD MAURICIO OTTO SAGREDO","userId":"18329832569786394568"}},"outputId":"3cb69492-1b0e-4106-95f6-dd5882b91af3"},"outputs":[{"output_type":"display_data","data":{"text/plain":["VBox(children=(IntText(value=1988, description='Año inicio:'), IntText(value=2026, description='Año fin:'), Bu…"],"application/vnd.jupyter.widget-view+json":{"version_major":2,"version_minor":0,"model_id":"d9a2ccdcda7942abad4e377da27dc07a"}},"metadata":{}}],"source":["import csv\n","import ipywidgets as widgets\n","import matplotlib.pyplot as plt\n","import matplotlib.ticker as ticker\n","from IPython.display import display\n","from collections import defaultdict\n","\n","CSV_PATH = \"/content/PAPERS EN COMPUTER SCIENCE USM.csv\"  # <-- cambia esto si es necesario\n","\n","def cargar_datos(path):\n","    datos = defaultdict(list)\n","    with open(path, encoding=\"utf-8-sig\") as f:\n","        for row in csv.DictReader(f):\n","            cited = row.get(\"Cited by\", \"\").strip()\n","            year  = row.get(\"Year\", \"\").strip()\n","            if cited.isdigit() and year.isdigit():\n","                datos[int(year)].append(int(cited))\n","    return datos\n","\n","def calcular_h_index(citas):\n","    citas_ord = sorted(citas, reverse=True)\n","    return sum(1 for i, c in enumerate(citas_ord, 1) if c >= i)\n","\n","def h_index_por_periodos(datos, anios, tam=5):\n","    inicio = (anios[0] // tam) * tam\n","    periodos, h_values = [], []\n","    while inicio <= anios[-1]:\n","        fin   = inicio + tam - 1\n","        citas = [c for a in range(inicio, fin + 1) for c in datos.get(a, [])]\n","        if citas:\n","            periodos.append(f\"{inicio}–{fin}\")\n","            h_values.append(calcular_h_index(citas))\n","        inicio += tam\n","    return periodos, h_values\n","\n","def graficar_evolucion(datos, anios, a, b):\n","    # --- Gráfico 1: h-index por periodos de 5 años (todos los datos) ---\n","    periodos, h_vals = h_index_por_periodos(datos, anios)\n","\n","    # --- Gráfico 2: h-index acumulado año a año ---\n","    acumulado, h_acum = [], []\n","    citas_acum = []\n","    for anio in anios:\n","        citas_acum += datos[anio]\n","        acumulado.append(anio)\n","        h_acum.append(calcular_h_index(citas_acum))\n","\n","    # --- Gráfico 3: h-index anual (solo papers de ese año) ---\n","    h_anual = [calcular_h_index(datos[a]) for a in anios]\n","\n","    fig, axes = plt.subplots(1, 3, figsize=(18, 5))\n","    fig.suptitle(\"Evolución del h-index\", fontsize=14, fontweight=\"bold\", y=1.02)\n","\n","    # Barras por periodo\n","    axes[0].bar(periodos, h_vals, color=\"steelblue\", edgecolor=\"white\")\n","    axes[0].set_title(\"h-index por periodos de 5 años\")\n","    axes[0].set_xlabel(\"Periodo\")\n","    axes[0].set_ylabel(\"h-index\")\n","    axes[0].tick_params(axis=\"x\", rotation=45)\n","    for i, v in enumerate(h_vals):\n","        axes[0].text(i, v + 0.3, str(v), ha=\"center\", fontsize=9)\n","\n","    # Línea acumulada\n","    axes[1].plot(acumulado, h_acum, marker=\"o\", color=\"steelblue\", linewidth=2)\n","    axes[1].set_title(\"h-index acumulado (año a año)\")\n","    axes[1].set_xlabel(\"Año\")\n","    axes[1].set_ylabel(\"h-index acumulado\")\n","    axes[1].xaxis.set_major_locator(ticker.MultipleLocator(5))\n","    axes[1].tick_params(axis=\"x\", rotation=45)\n","    axes[1].grid(axis=\"y\", linestyle=\"--\", alpha=0.5)\n","\n","    # Línea anual\n","    axes[2].plot(anios, h_anual, marker=\"o\", color=\"darkorange\", linewidth=2)\n","    axes[2].set_title(\"h-index anual (papers de cada año)\")\n","    axes[2].set_xlabel(\"Año\")\n","    axes[2].set_ylabel(\"h-index\")\n","    axes[2].xaxis.set_major_locator(ticker.MultipleLocator(5))\n","    axes[2].tick_params(axis=\"x\", rotation=45)\n","    axes[2].grid(axis=\"y\", linestyle=\"--\", alpha=0.5)\n","\n","    plt.tight_layout()\n","    plt.show()\n","\n","# ── UI ──────────────────────────────────────────────────────────────────────\n","datos = cargar_datos(CSV_PATH)\n","anios = sorted(datos)\n","\n","anio_inicio = widgets.IntText(value=anios[0],  description=\"Año inicio:\")\n","anio_fin    = widgets.IntText(value=anios[-1], description=\"Año fin:\")\n","boton       = widgets.Button(description=\"Calcular h-index\", button_style=\"primary\")\n","salida      = widgets.Output()\n","\n","def on_click(_):\n","    salida.clear_output()\n","    with salida:\n","        a, b = anio_inicio.value, anio_fin.value\n","        if a > b:\n","            print(\"⚠️  El año de inicio debe ser menor o igual al año de fin.\")\n","            return\n","        citas = [c for year in range(a, b + 1) for c in datos.get(year, [])]\n","        if not citas:\n","            print(f\"No hay papers registrados entre {a} y {b}.\")\n","            return\n","        h = calcular_h_index(citas)\n","        print(f\"Para el periodo {a}–{b}, el h-index fue de {h}\\n\")\n","        graficar_evolucion(datos, anios, a, b)\n","\n","boton.on_click(on_click)\n","display(widgets.VBox([anio_inicio, anio_fin, boton, salida]))"]}]}