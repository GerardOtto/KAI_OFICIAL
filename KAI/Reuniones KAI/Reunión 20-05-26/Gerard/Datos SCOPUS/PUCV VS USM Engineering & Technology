ascending=False)\n","\n","fig_rank_papers = px.bar(\n","    ranking_papers,\n","    x='papers',\n","    y='university',\n","    orientation='h',\n","    text='papers',\n","    template=TEMPLATE,\n","    title='Ranking Total de Producción Científica',\n","    labels={\n","        'papers': 'Total de Papers',\n","        'university': 'Universidad'\n","    }\n",")\n","\n","fig_rank_papers.update_traces(textposition='outside')\n","\n","fig_rank_papers.update_layout(\n","    title_x=0.5,\n","    height=500,\n","    yaxis={'categoryorder':'total ascending'},\n","    font=dict(size=14)\n",")\n","\n","fig_rank_papers.show()\n","\n","# =========================================================\n","# 4. EFICIENCIA CIENTÍFICA\n","# =========================================================\n","\n","ranking_cpp = resumen.sort_values('cit_per_paper', ascending=False)\n","\n","fig_cpp = px.bar(\n","    ranking_cpp,\n","    x='university',\n","    y='cit_per_paper',\n","    text='cit_per_paper',\n","    template=TEMPLATE,\n","    title='Impacto Promedio — Citaciones por Paper',\n","    labels={\n","        'cit_per_paper': 'Citas por Paper',\n","        'university': 'Universidad'\n","    }\n",")\n","\n","fig_cpp.update_traces(textposition='outside')\n","\n","fig_cpp.update_layout(\n","    title_x=0.5,\n","    height=500,\n","    font=dict(size=14)\n",")\n","\n","fig_cpp.show()\n","\n","# =========================================================\n","# 5. DASHBOARD EJECUTIVO RESUMIDO\n","# =========================================================\n","\n","fig_dashboard = make_subplots(\n","    rows=1,\n","    cols=2,\n","    subplot_titles=(\n","        'Citaciones Totales',\n","        'Citas por Paper'\n","    )\n",")\n","\n","# =========================================================\n","# 1. CITACIONES TOTALES\n","# =========================================================\n","\n","fig_dashboard.add_trace(\n","    go.Bar(\n","        x=resumen['university'],\n","        y=resumen['citations'],\n","        name='Citaciones'\n","    ),\n","    row=1,\n","    col=1\n",")\n","\n","# =========================================================\n","# 2. CITAS POR PAPER\n","# =========================================================\n","\n","fig_dashboard.add_trace(\n","    go.Bar(\n","        x=resumen['university'],\n","        y=resumen['cit_per_paper'],\n","        name='CPP'\n","    ),\n","    row=1,\n","    col=2\n",")\n","\n","# =========================================================\n","# LAYOUT FINAL\n","# =========================================================\n","\n","fig_dashboard.update_layout(\n","    height=600,\n","    template='plotly_white',\n","    title='Dashboard Ejecutivo',\n","    title_x=0.5,\n","    showlegend=False,\n","    font=dict(size=14)\n",")\n","\n","fig_dashboard.show()\n","\n","# =========================================================\n","# EXPORTAR A HTML INTERACTIVO\n","# =========================================================\n","\n","fig_dashboard.write_html('dashboard_ejecutivo.html')\n","\n","print('Dashboard exportado como: dashboard_ejecutivo.html')"]}]}